# API Base URL Configuration
# 
# This file configures where the frontend sends API requests.
# Copy this file to .env and adjust the value if your backend is not at the default location.
#
# IMPORTANT: After changing this file, you MUST restart the Vite dev server:
#   pnpm run dev
#
# Default behavior (when VITE_API_BASE_URL is not set):
# - In development: Vite proxy forwards /api/* to http://localhost:8000
# - In production: Uses same origin as frontend (window.location.origin)
#
# Examples:
# 
# Local backend on default port (no need to set this):
# VITE_API_BASE_URL=http://localhost:8000
#
# Local backend on different port:
# VITE_API_BASE_URL=http://localhost:8080
#
# Local backend on 127.0.0.1 instead of localhost:
# VITE_API_BASE_URL=http://127.0.0.1:8000
#
# Remote backend:
# VITE_API_BASE_URL=https://api.example.com
#
# How to verify configuration:
# 1. Check DevTools > Network tab to see where requests are sent
# 2. Requests to /api/v1/* should go to your configured backend URL
# 3. If requests timeout (25s), check:
#    - Backend is running and accessible
#    - URL is correct (no typos in host/port)
#    - Vite dev server was restarted after changing .env
VITE_API_BASE_URL=http://localhost:8000
